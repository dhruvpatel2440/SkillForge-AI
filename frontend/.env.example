VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Absolute backend URL for production (e.g. Render). Leave unset for local dev —
# the Vite proxy in vite.config.ts routes /api to localhost:8000 automatically.
VITE_API_URL=https://your-backend.onrender.com/api
